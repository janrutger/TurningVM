DEFINE
    VALUE FPbits 12

    THING FP 
        INIT
        END
        THIS to 
            FPbits `bsl
        END
        THIS from 
            FPbits `bsr
        END
        THIS add
            +
        END
        THIS min
            -
        END
        THIS mul
            * FPbits `bsr
        END
        THIS div
            . AS THIS tmp
            FPbits `bsl
            THIS tmp /
        END
        THIS frac
            DUP FPbits `bsr FPbits `bsl -
        END 
        THIS print
            `FPprint
        END
    END
END


USE FP

1 FP to AS a 
6 FP to AS b
3 FP to AS c

b c FP div FP frac FP print