DEFINE
    VALUE FPbits 12

    THING FP 
        INIT
            12 AS FPbits
            
            1 FPbits 1 - `bsl AS THIS half
            1 FPbits     `bsl AS THIS one
        END
        THIS to 
            FPbits `bsl
        END
        THIS from 
            FPbits `bsr
        END
        THIS add
            +
        END
        THIS min
            -
        END
        THIS mul
            * FPbits `bsr
        END
        THIS div
            . AS THIS tmp
            FPbits `bsl
            THIS tmp /
        END
        THIS sqrt
            `isqrt FPbits 2 / `bsl
        END
        THIS frac
            DUP FPbits `bsr FPbits `bsl -
        END 
        THIS floor
            FPbits `bsr FPbits `bsl
        END 
        THIS ceil
            DUP
            THIS frac AS THIS fraction
            FPbits `bsr FPbits `bsl
            THIS fraction 0 < DO
                THIS one +
            END            
        END
        THIS round
            DUP
            THIS frac AS THIS fraction
            FPbits `bsr FPbits `bsl
            THIS fraction THIS half < DO
                THIS one +
            END            
        END
        THIS print
            `FPprint
        END
    END
END


USE FP

25 FP to AS a 
11 FP to AS b
13 FP to AS c

b c FP div FP print