

FUNCTION p1 
    4.0 2 3 4 * * FPN DIV 
END

FUNCTION p2
    4.0 4 5 6 * * FPN DIV 
END

FUNCTION p3
    4.0 6 7 8 * * FPN DIV 
END

FUNCTION p4
    4.0 8 9 10 * * FPN DIV 
END

FUNCTION p5
    4.0 10 11 12 * * FPN DIV 
END

FUNCTION p6
    4.0 12 13 14 * * FPN DIV 
END

FUNCTION p7
    4.0 14 15 16 * * FPN DIV 
END

FUNCTION p8
    4.0 16 17 18 * * FPN DIV 
END

FUNCTION p9
    4.0 18 19 20 * * FPN DIV 
END





3.0 p1 + 
    p2 - 
    p3 + 
    p4 - 
    p5 + 
    p6 - 
    p7 + 
    p8 -
    p9 + FPRINT

    1.0 3.0 DIV 3.0 MUL FPRINT
